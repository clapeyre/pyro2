[driver]
cfl       = 0.8           ; advective CFL number


[advection]
backend = numpy       ; numpy (default) or optional warp backend
warp_device = cuda:0  ; Warp device, e.g. cuda:0 or cpu

u = 1.0      ; advective velocity in x-direction
v = 1.0      ; advective velocity in y-direction

limiter = 2  ; limiter (0 = none, 1 = 2nd order, 2 = 4th order)


[particles]
do_particles = 0
particle_generator = grid
